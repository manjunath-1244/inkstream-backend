# Environment configuration example
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inkstream

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=inkstream
S3_PUBLIC_URL=http://localhost:9000/inkstream

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@inkstream.com

# Authentication & JWT Setup
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# Rate Limiting Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# pgAdmin Default Credentials (used in docker-compose)
PGADMIN_DEFAULT_EMAIL=admin@inkstream.local
PGADMIN_DEFAULT_PASSWORD=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
